<Window x:Class="Aqroflow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aqroflow" Width="280" Height="110"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" Loaded="Window_Loaded">

    <Window.Resources>
        <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF5A623" Offset="0"/>
            <GradientStop Color="#FFFA6E32" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <!-- pulse ring behind the pill, shown while recording -->
        <Ellipse x:Name="PulseRing" Width="54" Height="54"
                 Stroke="{StaticResource AccentGrad}" StrokeThickness="2.5" Opacity="0"
                 IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FFF5A623" Opacity="0.6"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- the pill / button -->
        <Border x:Name="Pill" Width="54" Height="54" CornerRadius="27"
                Background="#FF101014" BorderBrush="#33FFFFFF" BorderThickness="1"
                Cursor="Hand"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonDown="Pill_MouseLeftButtonDown"
                MouseMove="Pill_MouseMove"
                MouseLeftButtonUp="Pill_MouseLeftButtonUp"
                MouseEnter="Pill_MouseEnter"
                MouseLeave="Pill_MouseLeave"
                ToolTip="Aqroflow — click to dictate">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="PillShadow" BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.4"/>
            </Border.Effect>

            <Grid>
                <!-- Aqro logo mark (idle / hover) -->
                <Path x:Name="LogoPath" Fill="{StaticResource AccentGrad}" Stretch="Uniform"
                      Width="20" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M0,0 H295 V265 H140 V155 H0 Z"/>

                <!-- recording waveform (Wispr Flow style bars) -->
                <StackPanel x:Name="Waveform" Orientation="Horizontal" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Width="3" Height="6" Margin="2,0" RadiusX="1.5" RadiusY="1.5" Fill="#FFF5A623"/>
                    <Rectangle Width="3" Height="6" Margin="2,0" RadiusX="1.5" RadiusY="1.5" Fill="#FFFA6E32"/>
                    <Rectangle Width="3" Height="6" Margin="2,0" RadiusX="1.5" RadiusY="1.5" Fill="#FFF5A623"/>
                    <Rectangle Width="3" Height="6" Margin="2,0" RadiusX="1.5" RadiusY="1.5" Fill="#FFFA6E32"/>
                    <Rectangle Width="3" Height="6" Margin="2,0" RadiusX="1.5" RadiusY="1.5" Fill="#FFF5A623"/>
                    <Rectangle Width="3" Height="6" Margin="2,0" RadiusX="1.5" RadiusY="1.5" Fill="#FFFA6E32"/>
                    <Rectangle Width="3" Height="6" Margin="2,0" RadiusX="1.5" RadiusY="1.5" Fill="#FFF5A623"/>
                </StackPanel>

                <!-- transcribing spinner -->
                <Ellipse x:Name="Spinner" Width="26" Height="26" Stroke="{StaticResource AccentGrad}" StrokeThickness="3"
                         StrokeDashArray="6 20" StrokeDashCap="Round" Visibility="Collapsed"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- model download progress -->
                <TextBlock x:Name="ProgressText" Visibility="Collapsed" Foreground="White"
                           FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
