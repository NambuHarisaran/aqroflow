<Window x:Class="Aqroflow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aqroflow" Width="72" Height="72"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" Loaded="Window_Loaded">
    <Grid>
        <!-- pulse ring, visible while recording -->
        <Ellipse x:Name="PulseRing" Width="56" Height="56"
                 Stroke="#FFE53935" StrokeThickness="3" Opacity="0"
                 IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- main button -->
        <Border x:Name="Btn" Width="52" Height="52" CornerRadius="26" Cursor="Hand"
                MouseLeftButtonDown="Btn_MouseLeftButtonDown"
                MouseMove="Btn_MouseMove"
                MouseLeftButtonUp="Btn_MouseLeftButtonUp"
                ToolTip="Aqroflow — click to dictate">
            <Border.Background>
                <LinearGradientBrush x:Name="BtnBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="Grad1" Color="#FF00C6A7" Offset="0"/>
                    <GradientStop x:Name="Grad2" Color="#FF0072FF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Exit Aqroflow" Click="Exit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <!-- mic glyph -->
                <Path x:Name="MicIcon" Fill="White" Stretch="Uniform" Width="20" Height="20"
                      Data="M12,2 C10.34,2 9,3.34 9,5 L9,11 C9,12.66 10.34,14 12,14 C13.66,14 15,12.66 15,11 L15,5 C15,3.34 13.66,2 12,2 Z M17,11 C17,13.76 14.76,16 12,16 C9.24,16 7,13.76 7,11 L5,11 C5,14.53 7.61,17.43 11,17.92 L11,21 L13,21 L13,17.92 C16.39,17.43 19,14.53 19,11 Z"/>
                <!-- spinner while transcribing -->
                <Ellipse x:Name="Spinner" Width="24" Height="24" Stroke="White" StrokeThickness="3"
                         StrokeDashArray="6 20" StrokeDashCap="Round" Visibility="Collapsed"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <!-- model download progress -->
                <TextBlock x:Name="ProgressText" Visibility="Collapsed" Foreground="White"
                           FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
