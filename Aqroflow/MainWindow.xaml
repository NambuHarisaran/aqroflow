<Window x:Class="Aqroflow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aqroflow" Width="280" Height="110"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" Loaded="Window_Loaded">
    <Grid>
        <!-- pulse ring behind the pill, shown while recording -->
        <Ellipse x:Name="PulseRing" Width="52" Height="52"
                 Stroke="#FFF2A93C" StrokeThickness="2.5" Opacity="0"
                 IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- the pill / button -->
        <Border x:Name="Pill" Width="52" Height="52" CornerRadius="26"
                Background="#FF1C1C1F" Cursor="Hand"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonDown="Pill_MouseLeftButtonDown"
                MouseMove="Pill_MouseMove"
                MouseLeftButtonUp="Pill_MouseLeftButtonUp"
                MouseEnter="Pill_MouseEnter"
                MouseLeave="Pill_MouseLeave"
                ToolTip="Aqroflow — click to dictate">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="PillShadow" BlurRadius="14" ShadowDepth="0"
                                  Color="#000000" Opacity="0.5"/>
            </Border.Effect>

            <Grid>
                <!-- Aqro logo mark (idle / hover) -->
                <Path x:Name="LogoPath" Fill="#FFF2A93C" Stretch="Uniform"
                      Width="20" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M0,0 H295 V265 H140 V155 H0 Z"/>

                <!-- recording waveform (Wispr Flow style bars) -->
                <StackPanel x:Name="Waveform" Orientation="Horizontal" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Width="3" Height="6" Margin="2,0" RadiusX="1.5" RadiusY="1.5" Fill="#FFF2A93C"/>
                    <Rectangle Width="3" Height="6" Margin="2,0" RadiusX="1.5" RadiusY="1.5" Fill="#FFF2A93C"/>
                    <Rectangle Width="3" Height="6" Margin="2,0" RadiusX="1.5" RadiusY="1.5" Fill="#FFF2A93C"/>
                    <Rectangle Width="3" Height="6" Margin="2,0" RadiusX="1.5" RadiusY="1.5" Fill="#FFF2A93C"/>
                    <Rectangle Width="3" Height="6" Margin="2,0" RadiusX="1.5" RadiusY="1.5" Fill="#FFF2A93C"/>
                    <Rectangle Width="3" Height="6" Margin="2,0" RadiusX="1.5" RadiusY="1.5" Fill="#FFF2A93C"/>
                    <Rectangle Width="3" Height="6" Margin="2,0" RadiusX="1.5" RadiusY="1.5" Fill="#FFF2A93C"/>
                </StackPanel>

                <!-- transcribing spinner -->
                <Ellipse x:Name="Spinner" Width="24" Height="24" Stroke="#FFF2A93C" StrokeThickness="3"
                         StrokeDashArray="6 20" StrokeDashCap="Round" Visibility="Collapsed"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- model download progress -->
                <TextBlock x:Name="ProgressText" Visibility="Collapsed" Foreground="White"
                           FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
