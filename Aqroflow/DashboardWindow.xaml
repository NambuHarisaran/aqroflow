<Window x:Class="Aqroflow.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aqroflow" Width="760" Height="520"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1B1E" Foreground="#FFEDEDED"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FFF2A93C"/>
        <SolidColorBrush x:Key="Card" Color="#FF26262B"/>
        <SolidColorBrush x:Key="Sub" Color="#FF9A9AA2"/>

        <!-- nav button -->
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFCFCFD4"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF33333A"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF2E2E34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- primary button -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#FF1B1B1E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- subtle/secondary button -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Background" Value="#FF33333A"/>
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF3E3E46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="34"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- sidebar -->
        <Border Grid.Column="0" Background="#FF222226">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,0,18">
                    <Path Fill="{StaticResource Accent}" Stretch="Uniform" Width="22" Height="20"
                          Data="M0,0 H295 V265 H140 V155 H0 Z"/>
                    <TextBlock Text="Aqroflow" FontSize="18" FontWeight="SemiBold"
                               Foreground="#FFEDEDED" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,16">
                    <TextBlock x:Name="StatusDot" Text="● loading…" Foreground="{StaticResource Sub}" FontSize="12"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavBtn}" Content="Dashboard" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings"  Style="{StaticResource NavBtn}" Content="Settings"  Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAbout"     Style="{StaticResource NavBtn}" Content="About"     Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- content -->
        <Grid Grid.Column="1" Margin="28,24">

            <!-- ===== DASHBOARD ===== -->
            <StackPanel x:Name="PageDashboard">
                <TextBlock Text="Dashboard" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Local voice dictation — your audio never leaves this device."
                           Foreground="{StaticResource Sub}" Margin="0,0,0,20"/>

                <Border Background="{StaticResource Card}" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <Button x:Name="RecordBtn" Style="{StaticResource Primary}" Width="180" Height="46"
                                Content="Start dictation" Click="RecordBtn_Click"/>
                        <TextBlock x:Name="HintText" Text="or hold Right Ctrl anywhere"
                                   Foreground="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Card}" CornerRadius="12" Padding="18" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock x:Name="StatCount" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="dictations" Foreground="{StaticResource Sub}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource Card}" CornerRadius="12" Padding="18" Margin="8,0">
                        <StackPanel>
                            <TextBlock x:Name="StatWords" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="words" Foreground="{StaticResource Sub}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource Card}" CornerRadius="12" Padding="18" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock x:Name="StatModel" Text="tiny.en" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="model" Foreground="{StaticResource Sub}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="Last transcript" Foreground="{StaticResource Sub}" Margin="0,20,0,6"/>
                <Border Background="{StaticResource Card}" CornerRadius="10" Padding="14" MinHeight="60">
                    <TextBlock x:Name="LastText" Text="—" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <!-- ===== SETTINGS ===== -->
            <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <TextBlock Text="Hotkey" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Background="{StaticResource Card}" CornerRadius="12" Padding="18" Margin="0,0,0,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Key:" VerticalAlignment="Center" Foreground="{StaticResource Sub}" Width="60"/>
                                <Border Background="#FF33333A" CornerRadius="6" Padding="12,6">
                                    <TextBlock x:Name="KeyLabel" Text="Right Ctrl" FontWeight="SemiBold"/>
                                </Border>
                                <Button x:Name="ChangeKeyBtn" Style="{StaticResource Ghost}" Content="Change" Margin="12,0,0,0" Click="ChangeKey_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="Mode:" VerticalAlignment="Center" Foreground="{StaticResource Sub}" Width="60"/>
                                <RadioButton x:Name="ModePush" Content="Push-to-talk (hold)" Foreground="#FFEDEDED" VerticalAlignment="Center" Margin="0,0,20,0" Checked="Mode_Checked"/>
                                <RadioButton x:Name="ModeToggle" Content="Toggle (tap)" Foreground="#FFEDEDED" VerticalAlignment="Center" Checked="Mode_Checked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Model &amp; language" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Background="{StaticResource Card}" CornerRadius="12" Padding="18" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Speech model" Foreground="{StaticResource Sub}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ModelCombo" SelectionChanged="ModelCombo_Changed"/>
                            <TextBlock Text="Language" Foreground="{StaticResource Sub}" Margin="0,14,0,6"/>
                            <ComboBox x:Name="LangCombo"/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="ApplyModelBtn" Style="{StaticResource Primary}" Content="Apply / download" Click="ApplyModel_Click"/>
                                <ProgressBar x:Name="ModelProgress" Width="160" Height="10" Margin="14,0,0,0" VerticalAlignment="Center"
                                             Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="{StaticResource Accent}"/>
                                <TextBlock x:Name="ModelStatus" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource Sub}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Floating widget position" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Background="{StaticResource Card}" CornerRadius="12" Padding="18" Margin="0,0,0,18">
                        <StackPanel>
                            <WrapPanel>
                                <Button Style="{StaticResource Ghost}" Content="Top left"      Tag="topLeft"      Click="Position_Click"/>
                                <Button Style="{StaticResource Ghost}" Content="Top center"    Tag="topCenter"    Click="Position_Click"/>
                                <Button Style="{StaticResource Ghost}" Content="Top right"     Tag="topRight"     Click="Position_Click"/>
                                <Button Style="{StaticResource Ghost}" Content="Bottom left"   Tag="bottomLeft"   Click="Position_Click"/>
                                <Button Style="{StaticResource Ghost}" Content="Bottom center" Tag="bottomCenter" Click="Position_Click"/>
                                <Button Style="{StaticResource Ghost}" Content="Bottom right"  Tag="bottomRight"  Click="Position_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="PositionNote" Foreground="{StaticResource Sub}" Margin="0,6,0,0"
                                       Text="You can also drag the floating widget anywhere."/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Card}" CornerRadius="12" Padding="18">
                        <CheckBox x:Name="StartupCheck" Content="Launch Aqroflow when Windows starts"
                                  Foreground="#FFEDEDED" Click="Startup_Click"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== ABOUT ===== -->
            <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                <TextBlock Text="About" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/>
                <Border Background="{StaticResource Card}" CornerRadius="12" Padding="24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Path Fill="{StaticResource Accent}" Stretch="Uniform" Width="30" Height="27"
                                  Data="M0,0 H295 V265 H140 V155 H0 Z"/>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Aqroflow" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="VersionText" Text="v1.0" Foreground="{StaticResource Sub}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#FFCFCFD4" Margin="0,0,0,10"
                                   Text="Free, local voice dictation for Windows. Speak anywhere and your words are typed into whatever app you last clicked. Fully offline — no cloud, no accounts, no cost."/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Sub}"
                                   Text="Built with .NET / WPF, Whisper.net (whisper.cpp) and NAudio. Models by OpenAI Whisper, quantized by ggerganov/whisper.cpp."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
